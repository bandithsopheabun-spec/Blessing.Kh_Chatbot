# ============================================================
#  Blessing.Kh Marketing Bot  —  @blessing_kh_chatbot
#  Copy this file to .env and fill in the values.
# ============================================================

# Telegram bot token for @blessing_kh_chatbot (from @BotFather)
BOT_TOKEN=your-telegram-bot-token-here

# The MAIN ordering bot that customers are funnelled to (no leading @)
MAIN_BOT_USERNAME=BlessingKhV1_Bot

# Deep-link ref passed as ?start=<param> when opening the main bot.
# The per-service buttons append the service id, e.g. catalog_tiktok_likes
ORDER_START_PARAM=catalog

# Links shown in the menu
SUPPORT_LINK=https://t.me/Blessing_Kh_Supports
CHANNEL_LINK=https://t.me/Blessing_Kh_Public/3

# HTTP health-check port (Render injects PORT automatically)
PORT=3000

# Optional — set by Render automatically; enables the keep-awake self-ping
# RENDER_EXTERNAL_URL=https://blessing-kh-chatbot.onrender.com
